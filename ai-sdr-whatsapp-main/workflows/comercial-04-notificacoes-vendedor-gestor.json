              "name": "X-Api-Key",
              "value": "YOUR_WAHA_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": \"{{ $json.vendedor_fone }}@c.us\",\n  \"text\": {{ JSON.stringify('*🔔 O lead respondeu o acompanhamento!*\\n\\n*👤 Lead:* ' + ($('Dados p/ notificação').item.json.lead_nome || '') + '\\n*📌 Deal:* ' + ($('Recebe dados do Agente').item.json.deal_id || '') + '\\n*📝 Resumo:* ' + ($('Recebe dados do Agente').item.json.resumo || '') + '\\n\\n*💬 Mensagem do lead:*\\n\"' + ($('Recebe dados do Agente').item.json.mensagem_lead || '') + '\"\\n\\n*📲 Falar com o lead:* https://wa.me/' + ($('Dados p/ notificação').item.json.lead_fone || '')) }},\n  \"session\": \"waha-session-001\"\n}",
        "options": {}
      },
