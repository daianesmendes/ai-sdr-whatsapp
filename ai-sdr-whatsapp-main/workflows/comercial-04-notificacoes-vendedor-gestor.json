      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Puxa telefone do vendedor + credenciais Z-API do remetente (CEO), pelo deal.\nSELECT TOP 1\n       w.zapi_instance, w.zapi_token, w.zapi_client_token,\n       v.first_name AS vendedor_nome,\n       NULLIF(v.cellphone1, '') AS vendedor_fone,\n       d.first_name AS lead_nome, d.cellphone1 AS lead_fone\n  FROM crm_deal a\n INNER JOIN crm_person d ON a.person_id = d.id\n INNER JOIN crm_user v ON a.user_id = v.user_id\n CROSS JOIN (SELECT zapi_instance, zapi_token, zapi_client_token FROM crm_user WHERE user_id = '000000') w\n WHERE a.id = '{{ $json.deal_id }}';",
        "options": {}
      },
      "id": "4e341208-f766-4b03-96a4-273670a242c7",
      "name": "Dados p/ notificação",
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1,
      "position": [
        144,
        528
      ],
      "credentials": {
        "microsoftSql": {
          "id": "CRED_MSSQL",
          "name": "SQL Server (ERP)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "nv1",
              "leftValue": "={{ $('Recebe dados do Agente').item.json.notificar_vendedor }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "nv2",
              "leftValue": "={{ $json.vendedor_fone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8e51db88-1db7-4e8a-9134-e04a6ff6eb4b",
      "name": "Notificar vendedor?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        384,
        416
      ]
    },
    {
