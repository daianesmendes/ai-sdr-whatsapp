    {
      "parameters": {
        "jsCode": "// Interpreta a interação da SDR no grupo (comando de texto: aprovar / reprovar / parar).\nconst b = $json.body ?? $json;\nconst raw = (b.text && b.text.message) ? b.text.message : (b.body || '');\nconst txt = String(raw).trim().toLowerCase();\nlet acao = '';\nif (txt.startsWith('aprovar')) acao = 'aprovar';\nelse if (txt.startsWith('reprovar')) acao = 'reprovar';\nelse if (txt.startsWith('parar') || txt.includes('ia parar')) acao = 'parar';\nconst quotedId = b.quotedId || '';\nreturn [{ json: { acao, quotedId, texto: raw } }];"
      },
